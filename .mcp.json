{
  "mcpServers": {
    "clawdnd-engine": {
      "type": "stdio",
      "command": "uv",
      "alwaysLoad": true,
      "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}/servers/engine", "server.py"]
    },
    "clawdnd-rules": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}/servers/rules", "server.py"]
    },
    "clawdnd-voice": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}/servers/voice", "--group", "kokoro", "server.py"],
      "env": {
        "WORLDOS_TTS_BACKEND": "kokoro"
      }
    }
  }
}
