{
  "mcpServers": {
    "worldos-engine": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "servers/engine",
        "server.py"
      ],
      "env": {
        "CLAWDND_STATE_DIR": "qa/state"
      }
    },
    "worldos-rules": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "servers/rules",
        "server.py"
      ],
      "env": {
        "WORLDOS_RULES_OFFLINE": "1"
      }
    },
    "worldos-voice": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "servers/voice",
        "server.py"
      ],
      "env": {
        "WORLDOS_TTS_BACKEND": "null"
      }
    }
  }
}
