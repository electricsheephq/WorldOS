{
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "progressed", "acts", "scores", "overall", "defects", "highlights", "verdict"],
  "properties": {
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_craft",
        "grandeur",
        "character_depth",
        "prose_atmosphere",
        "dramatic_momentum",
        "thematic_resonance",
        "memorability"
      ],
      "properties": {
        "scene_craft": { "type": "number", "minimum": 1, "maximum": 5 },
        "grandeur": { "type": "number", "minimum": 1, "maximum": 5 },
        "character_depth": { "type": "number", "minimum": 1, "maximum": 5 },
        "prose_atmosphere": { "type": "number", "minimum": 1, "maximum": 5 },
        "dramatic_momentum": { "type": "number", "minimum": 1, "maximum": 5 },
        "thematic_resonance": { "type": "number", "minimum": 1, "maximum": 5 },
        "memorability": { "type": "number", "minimum": 1, "maximum": 5 }
      }
    },
    "overall": { "type": "number", "minimum": 1, "maximum": 5 },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "area", "evidence", "suggested_fix"],
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "area": { "type": "string" },
          "evidence": { "type": "string" },
          "suggested_fix": { "type": "string" }
        }
      }
    },
    "highlights": { "type": "array", "items": { "type": "string" } },
    "verdict": { "type": "string" },
    "scope": { "type": "string", "description": "the arc scope this transcript represents: setup-slice | one-shot | short-3act | campaign-arc" },
    "progressed": { "type": "boolean", "description": "did the world MOVE over the session (clock advanced / party traveled to a new place / a new named face entered)? false for a long session frozen in one Act-1 scene — the failure-to-progress cap then binds overall <= 3.0" },
    "acts": {
      "type": "array",
      "description": "per-act assessment of the structure PRESENT (don't invent acts a short slice doesn't reach)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["act", "present", "assessment", "score"],
        "properties": {
          "act": { "type": "string" },
          "present": { "type": "boolean" },
          "assessment": { "type": "string" },
          "score": { "type": "number", "minimum": 1, "maximum": 5 }
        }
      }
    }
  }
}
