{
  "mcpServers": {
    "clawdnd-engine": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--directory", "/Volumes/LEXAR/repos/ClawDnD/servers/engine", "server.py"],
      "env": { "CLAWDND_STATE_DIR": "/Volumes/LEXAR/repos/ClawDnD/qa/state" }
    },
    "clawdnd-rules": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--directory", "/Volumes/LEXAR/repos/ClawDnD/servers/rules", "server.py"],
      "env": { "CLAWDND_RULES_OFFLINE": "1" }
    },
    "clawdnd-voice": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--directory", "/Volumes/LEXAR/repos/ClawDnD/servers/voice", "server.py"],
      "env": { "CLAWDND_TTS_BACKEND": "null" }
    }
  }
}
