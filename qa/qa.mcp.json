{
  "mcpServers": {
    "clawdnd-engine": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/Users/lume/WorldOS-val/servers/engine",
        "server.py"
      ],
      "env": {
        "CLAWDND_STATE_DIR": "/Users/lume/WorldOS-val/qa/state"
      }
    },
    "clawdnd-rules": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/Users/lume/WorldOS-val/servers/rules",
        "server.py"
      ],
      "env": {
        "CLAWDND_RULES_OFFLINE": "1"
      }
    },
    "clawdnd-voice": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/Users/lume/WorldOS-val/servers/voice",
        "server.py"
      ],
      "env": {
        "CLAWDND_TTS_BACKEND": "null"
      }
    }
  }
}